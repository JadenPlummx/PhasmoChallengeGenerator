<Window x:Class="PhasmoChallengeGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PhasmoChallengeGenerator"
        mc:Ignorable="d"
        Title="Phasmophobia Challenges"
        Height="600"
        Width="800"
        MinHeight="550"
        MinWidth="650"
        Background="#252525"
        WindowStartupLocation="CenterScreen">


<Grid Margin="20">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Application Title -->
    <TextBlock Text="Phasmophobia Challenges"
               FontSize="24"
               FontWeight="Bold"
               Foreground="White"
               HorizontalAlignment="Center"
               Margin="0,0,0,20"/>

    <!-- Ghost Hunting Rules (hopefully you survive) -->
    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto">


<StackPanel>

    <!-- This is Rule 1 -->
    <GroupBox Header="Rule 1"
              Foreground="White"
              Margin="0,5">

        <StackPanel Margin="10">

            <TextBlock x:Name="timerOne"
                       Text="05:00"
                       FontSize="24"
                       Foreground="White"/>

            <TextBlock x:Name="actionOne"
                       Text="If the ghost starts hunting..."
                       Foreground="White"
                       Margin="0,5"/>

            <TextBlock x:Name="consequenceOne"
                       Text="You cannot use your flashlight for 2 minutes."
                       Foreground="LightGray"/>

            <WrapPanel Margin="0,10,0,0">
                <Button x:Name="rerollOne"
                        Content="Reroll"
                        Margin="0,0,5,0"/>

                <Button x:Name="disableOne"
                        Content="Disable"
                        Margin="0,0,5,0"/>

                <Button x:Name="deleteOne"
                        Content="Delete"/>
            </WrapPanel>

        </StackPanel>

    </GroupBox>

</StackPanel>


    </ScrollViewer>

</Grid>

</Window>

    
