<Window x:Class="PhasmoChallengeGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PhasmoChallengeGenerator"
        mc:Ignorable="d"
        Height="600"
        Width="800"
        MinHeight="550"
        MinWidth="650"
        Background="#252525"
        WindowStartupLocation="CenterScreen"
        Loaded="WindowLoaded">


<Grid Margin="20">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Application Title -->
    <TextBlock Text="Phasmophobia Challenges"
               FontSize="24"
               FontWeight="Bold"
               Foreground="White"
               HorizontalAlignment="Center"
               Margin="0,0,0,20"/>

    <!-- Ghost Hunting Rules (hopefully you survive) -->
    <!-- I made this a have a scroll bar incase I wanted to add more in the future -->

    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto">


<StackPanel>

    <!-- This is Rule 1 -->
    <GroupBox Header="Rule 1"
              Foreground="White"
              Margin="0,5">

        <StackPanel Margin="10">

            <TextBlock x:Name="timerOne"
                       Text="05:00"
                       FontSize="24"
                       Foreground="White"/>

            <TextBlock x:Name="actionOne"
                       Text="If the ghost starts hunting..."
                       Foreground="White"
                       Margin="0,5"/>

            <TextBlock x:Name="consequenceOne"
                       Text="You cannot use your flashlight for 2 minutes."
                       Foreground="LightGray"/>

            <WrapPanel Margin="0,10,0,0">
                <Button x:Name="rerollOne"
                        Content="Reroll"
                        Margin="0,0,5,0"
                        ToolTip="Generate a new challenge for Rule 1."
                        Click="RerollOne_Click"/>

                <Button x:Name="disableOne"
                        Content="Disable"
                        Margin="0,0,5,0"/>

                <Button x:Name="deleteOne"
                        Content="Delete"/>
            </WrapPanel>

        </StackPanel>

    </GroupBox>

        <!-- This is Rule 2 -->
        <GroupBox Header="Rule 2"
                  Foreground="White"
                  Margin="0,5">
        
            <StackPanel Margin="10">
        
                <TextBlock x:Name="timerTwo"
                           Text="10:00"
                           FontSize="24"
                           Foreground="White"/>

                <TextBlock x:Name="actionTwo"
                           Text="If you enter the ghost room..."
                           Foreground="White"
                           Margin="0,5"/>

                <TextBlock x:Name="consequenceTwo"
                           Text="You must leave one piece of equipment outside."
                           Foreground="LightGray"/>

                <WrapPanel Margin="0,10,0,0">
                <Button x:Name="rerollTwo"
                        Content="Reroll"
                        Margin="0,0,5,0"
                        ToolTip="Generate a new challenge for Rule 2."
                        Click="RerollTwo_Click"/>



                    <Button x:Name="disableTwo"
                            Content="Disable"
                            Margin="0,0,5,0"/>

                    <Button x:Name="deleteTwo"
                            Content="Delete"/>
        </WrapPanel>

    </StackPanel>

</GroupBox>


        <!-- This is Rule 3 unfortunetly being the last rule -->
        <GroupBox Header="Rule 3"
                  Foreground="White"
                  Margin="0,5">

            <StackPanel Margin="10">

                <TextBlock x:Name="timerThree"
                           Text="15:00"
                           FontSize="24"
                           Foreground="White"/>

                <TextBlock x:Name="actionThree"
                           Text="If someone reaches 0% sanity..."
                           Foreground="White"
                           Margin="0,5"/>

                <TextBlock x:Name="consequenceThree"
                           Text="Everyone must return to the truck."
                           Foreground="LightGray"/>

                <WrapPanel Margin="0,10,0,0">
                <Button x:Name="rerollThree"
                        Content="Reroll"
                        Margin="0,0,5,0"
                        ToolTip="Generate a new challenge for Rule 3."
                        Click="RerollThree_Click"/>

                    <Button x:Name="disableThree"
                            Content="Disable"
                            Margin="0,0,5,0"/>

                    <Button x:Name="deleteThree"
                            Content="Delete"/>
        </WrapPanel>

    </StackPanel>

</GroupBox>


        <!-- Freeze time button -->
        <Button x:Name="pauseButton"
                Content="Pause All Timers"
                Height="35"
                Margin="0,15,0,0"
                Click="PauseButton_Click"
                ToolTip="Pause or resume all active challenge timers."/>


</StackPanel>


    </ScrollViewer>

</Grid>

</Window>

    
