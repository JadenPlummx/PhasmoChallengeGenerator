<Window x:Class="PhasmoChallengeGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PhasmoChallengeGenerator"
        mc:Ignorable="d"
        Title="Phasmophobia Challenges"
        Height="600"
        Width="800"
        MinHeight="550"
        MinWidth="650"
        Background="#252525"
        WindowStartupLocation="CenterScreen">


<Grid Margin="20">
    <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Application Title -->
    <TextBlock Text="Phasmophobia Challenges"
               FontSize="24"
               FontWeight="Bold"
               Foreground="White"
               HorizontalAlignment="Center"
               Margin="0,0,0,20"/>

    <!-- Ghost Hunting Rules (hopefully you survive) -->
    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto">

        <StackPanel>

        </StackPanel>

    </ScrollViewer>

</Grid>

</Window>

    
